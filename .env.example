# ==============================================================================
# UNIVERSAL BLOCKCHAIN TRANSACTION LEDGER (UBTL) - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application Settings
NODE_ENV="development"
PORT=3000
HOST="0.0.0.0"
APP_URL="http://localhost:3000"
LOG_LEVEL="info"

# Security & API Authentication
# API key used by the Digital Switching system to submit transactions to UBTL Gateway
UBTL_API_KEY="ubtl_dev_key_secret_switch_2026"
# Admin/Operator API key for ledger dashboard, health, and reconciliation operations
UBTL_ADMIN_API_KEY="ubtl_admin_secret_key_2026"

# Digital Switching Integration
# Target URL where UBTL delivers asynchronous lifecycle webhooks
SWITCHING_BASE_URL="http://localhost:4000"
SWITCHING_WEBHOOK_ENDPOINT="/api/v1/webhooks/gateway"
SWITCHING_WEBHOOK_API_KEY="switching_webhook_gateway_key_2026"
SWITCHING_WEBHOOK_TIMEOUT_MS=5000
SWITCHING_WEBHOOK_MAX_RETRIES=5

# HMAC-SHA256 signing (the convention adopted with the Switching team)
# Both directions sign the ASCII string `${timestamp}.${rawBody}` and hex-encode
# the digest. Header names are Switching's existing ones — do not invent new ones.
#
# (1) Switching -> UBTL (submit): Switching signs with its
#     GATEWAY_OUTBOUND_SHARED_SECRET using x-switching-signature /
#     x-switching-timestamp. Set the SAME value here so UBTL can verify it.
SWITCHING_OUTBOUND_SIGNING_SECRET=""
# Fail-closed switch. MUST be "true" in any real deployment that sets the secret
# above — a configured secret with enforcement off gives NO protection while
# appearing to (see docs/switching-integration.md §7).
SWITCHING_OUTBOUND_SIGNATURE_REQUIRED=false
# (2) UBTL -> Switching (webhook callback): UBTL signs with this secret using
#     x-gateway-signature / x-gateway-timestamp. Set Switching's
#     GATEWAY_WEBHOOK_SHARED_SECRET to the SAME value and set its
#     GATEWAY_WEBHOOK_SIGNATURE_REQUIRED=true to enforce it.
SWITCHING_WEBHOOK_SIGNING_SECRET=""
# Anti-replay tolerance window applied in BOTH directions (milliseconds).
SIGNATURE_TOLERANCE_MS=300000

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://ubtl_user:ubtl_password@localhost:5432/ubtl_db?schema=public&connection_limit=20&pool_timeout=10"

# Persistence backend for transactions, lifecycle history, idempotency, audit,
# outbox and reconciliation evidence. One of "auto", "postgres", "in-memory".
#   auto      -> PostgreSQL when DATABASE_URL is set, else in-memory
#                (fails closed in production if the database is unreachable)
#   postgres  -> require a reachable database; abort startup otherwise
#   in-memory -> explicit non-durable dev simulation (rejected if NODE_ENV=production)
# In-memory mode does NOT survive a restart. Use "postgres" for any real deployment.
UBTL_PERSISTENCE_BACKEND="auto"

# Blockchain Provider Neutrality Settings
# When BLOCKCHAIN_ADAPTER_MODE is "mock", UBTL simulates Fabric ledger behavior locally without requiring credentials.
# Set to "provider" when connecting to the managed external Hyperledger Fabric network provider.
BLOCKCHAIN_ADAPTER_MODE="mock"

# Mock Adapter Configuration (Only active when BLOCKCHAIN_ADAPTER_MODE="mock")
MOCK_FABRIC_COMMIT_DELAY_MS=1500
MOCK_FABRIC_FAILURE_RATE=0.0
MOCK_FABRIC_TIMEOUT_RATE=0.0

# External Hyperledger Fabric Provider Configuration (REQUIRED when BLOCKCHAIN_ADAPTER_MODE="provider")
# UBTL will fail fast on startup if these are missing in "provider" mode.
FABRIC_GATEWAY_PEER_ENDPOINT=""
FABRIC_GATEWAY_TLS_CERT_PATH=""
FABRIC_GATEWAY_CLIENT_CERT_PATH=""
FABRIC_GATEWAY_CLIENT_KEY_PATH=""
FABRIC_GATEWAY_MSP_ID=""
FABRIC_GATEWAY_CHANNEL_NAME=""
FABRIC_GATEWAY_CHAINCODE_NAME=""
FABRIC_GATEWAY_COMMIT_TIMEOUT_SECONDS=60
FABRIC_GATEWAY_DISCOVERY_AS_LOCALHOST=false

# Transactional Outbox & Background Worker Configuration
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_RETRIES=5
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_STUCK_TIMEOUT_MS=60000

# Canonical Hashing Specification
# NOTE: UBTL enforces ubtl-canonical-json-v1 (application-specific NFC-normalized
# canonicalization), NOT RFC 8785/JCS. Keep these aligned with the canonicalizer.
HASH_ALGORITHM="sha256"
CANONICALIZATION_SPEC="ubtl-canonical-json-v1"
HASH_VERSION="v1"

# Reconciliation Engine
# Bounded, observable reconciliation of RECONCILIATION_REQUIRED (and other
# explicitly eligible) transactions. Queries provider evidence before any
# resubmission; never infers commit from a submission acknowledgement.
RECONCILIATION_INTERVAL_MINUTES=60
RECONCILIATION_LOOKBACK_HOURS=24
RECONCILIATION_BATCH_SIZE=50
RECONCILIATION_MAX_ATTEMPTS=5
# Durable cross-worker reconciliation lock (PostgreSQL lease row). The lock is
# renewed by a heartbeat while a run is active and reclaimed after this many
# seconds if the owning worker crashes or its connection drops.
RECONCILIATION_LOCK_TTL_SECONDS=120
